{
	"name": "r3h6/form-typolink-checkbox",
	"description": "Typolink checkbox for TYPO3 form framework.",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"authors": [
		{
			"name": "R3 H6",
			"role": "Developer"
		}
	],
	"require": {
		"php": "^8.1",
		"typo3/cms-core": "^12.4 || ^13.4",
		"typo3/cms-form": "^12.4 || ^13.4"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.44",
		"helmich/typo3-typoscript-lint": "^3.0",
		"jangregor/phpstan-prophecy": "^1.0",
		"phpmd/phpmd": "@stable",
		"phpspec/prophecy-phpunit": "^2.0",
		"saschaegerer/phpstan-typo3": "^1.0",
		"typo3/cms-filelist": "^12.4 || ^13.4",
		"typo3/cms-fluid-styled-content": "^12.4 || ^13.4",
		"typo3/cms-install": "^12.4 || ^13.4",
		"typo3/cms-lowlevel": "^12.4 || ^13.4",
		"typo3/cms-recordlist": "^12.4 || ^13.4",
		"typo3/coding-standards": "^0.5.0",
		"typo3/testing-framework": "^8.0"
	},
	"replace": {
		"typo3-ter/form-typolink-checkbox": "self.version"
	},
	"autoload": {
		"psr-4": {
			"R3H6\\FormTypolinkCheckbox\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"R3H6\\FormTypolinkCheckbox\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"lock": false,
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "form_typolink_checkbox",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"ci:php:cs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config .php-cs-fixer.php -v --dry-run --using-cache no --diff",
		"ci:php:lint": "find *.php Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n 1 -P 4 php -l",
		"ci:php:md": "phpmd Classes/ text phpmd-ruleset.xml",
		"ci:php:stan": "phpstan --no-progress",
		"ci:test:unit": "phpunit -c .Build/vendor/typo3/testing-framework/Resources/Core/Build/UnitTests.xml Tests/Unit/",
		"fix:composer:normalize": "@composer normalize --no-check-lock",
		"fix:php:cs": "php-cs-fixer fix --config .php-cs-fixer.php",
		"symlink": [
			"rm -f .Build/public/fileadmin/form_definitions && mkdir -p .Build/public/fileadmin && ln -s ../../../Build/Data/fileadmin/form_definitions/ .Build/public/fileadmin/"
		]
	}
}
